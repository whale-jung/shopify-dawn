{% style %}
  .section-{{ section.id }}-product-card {

  }
{% endstyle %}
<div>
  {{ section.settings.introduction | remove: 'healthy' | upcase }}
  <div class="section-{{ section.id }}-product-card">
      {{ product.title }}
  </div>

</div>
{% schema %}
{
  "name": "product-card",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "label": "introduction",
      "id": "introduction",
      "default": "this is a product"
    }
  ],
  "presets": [
    {
      "name": "product_test"
    }
  ]
}
{% endschema %}
