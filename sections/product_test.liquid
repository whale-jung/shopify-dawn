{% style %}
  .section-{{ section.id }}-product-card {
    border: #ccc;
    border-radius: 20px;
  }
{% endstyle %}
<div>
  {{ section.settings.introduction | remove: 'healthy' | upcase }}
  <div class="section-{{ section.id }}-product-card">
        test
      {{ 9 | money_with_currency }}
  </div>

  {% assign item = 'shopify developer' %}
  {{ item | upcase }}

  {% capture paragraph_text %}
    <div>test01</div>
    <div>test023</div>
  {% endcapture %}
  {{ paragraph_text }}

  {% render 'atest-card',
    title: "test card",
    description: "this is a test card"
   %}

  test324
</div>
{% schema %}
{
  "name": "product-card",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "label": "introduction",
      "id": "introduction",
      "default": "this is a product"
    }
  ],
  "presets": [
    {
      "name": "product_test"
    }
  ]
}
{% endschema %}
