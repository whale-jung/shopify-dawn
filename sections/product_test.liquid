<div>
  {{ section.settings.introduction | remove: 'healthy' | upcase }}
  {{ product.title }}
</div>
{% schema %}
{
  "name": "product-card",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "label": "introduction",
      "id": "introduction",
      "default": "this is a product"
    }
  ],
  "presets": [
    {
      "name": "product_test"
    }
  ]
}
{% endschema %}
