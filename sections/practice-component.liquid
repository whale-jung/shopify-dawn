<div>
  {{ section.settings.practice_component }}

  {% form 'contact', class: 'contact-form', id: 'contact-form-debug' %}
    {% if form.posted_successfully? %}
      <p class="note">消息已发送</p>
    {% endif %}

    {% if form.errors %}
      {{ form.errors | default_errors }}
    {% endif %}

    <label for="ContactFormName">姓名</label>
    <input
      type="text"
      id="ContactFormName"
      name="contact[name]"
      value="{% if form.name %}{{ form.name }}{% elsif customer %}{{ customer.name }}{% endif %}"
    >

    <label for="ContactFormEmail">邮箱</label>
    <input type="email" id="ContactFormEmail" name="contact[email]" required>

    <label for="ContactFormMessage">留言</label>
    <textarea id="ContactFormMessage" name="contact[body]" rows="5"></textarea>

    <!-- 自定义字段示例 -->
    <label for="ContactFormOrder">订单号（选填）</label>
    <input type="text" id="ContactFormOrder" name="contact[order_number]">

    <button type="submit">ENTER</button>
  {% endform %}

  {% comment %} for {% endcomment %}
  {% for i in (1..5) %}
    {{ i }}
  {% endfor %}

  {% comment %} break：退出for循环 {% endcomment %}
  {% for i in (1..section.settings.max_number) %}
    {% if i == section.settings.limit_number %}
      {% break %}
    {% else %}
      <div style="color: red">
        {{ i }}
      </div>
    {% endif %}
  {% endfor %}

  {% comment %} continue：退出本次循环，进入下一次循环 {% endcomment %}
  {% for i in (1..section.settings.max_number) %}
    {% assign reminder = i | modulo: 2 %}
    {% if reminder == 0 %}
      {% continue %}
    {% else %}
      <div>
        {{ i }}
      </div>
    {% endif %}
  {% endfor %}

  {% comment %} cycle {% endcomment %}
  {% for i in (1..section.settings.max_number) %}
    <div>
      {% cycle 'one', 'two', 'three' %}
    </div>
  {% endfor %}

  {% comment %} else {% endcomment %}
  {% assign empty_arr = '' %}
  {% for i in empty_arr %}
    {{ i }}
  {% else %}
    <div>there is an empty array</div>
  {% endfor %}

  {% comment %} paginate {% endcomment %}
  {% comment %}
    {% assign paginate_data = (1..21) %}
    {% paginate paginate_data by 4 %}
      {% for item in paginate_data %}
        {{ item }}
      {% endfor %}
    {% endpaginate %}
  {% endcomment %}

  {% # this is a comment %}
  {% liquid
    # this is a comment
    assign topic = 'learning about comments!!'
    echo topic
  %}

  {% comment %} echo {% endcomment %}
  {{ section.settings.test_text }}
  {% echo section.settings.test_text %}
  {% liquid
    assign test = 'test??'
    echo test
  %}

  {% comment %} liquid {% endcomment %}
  {% liquid
    assign type = 'Health' | downcase
    assign message = ''

    case type
      when 'health'
        assign message = 'this is a health potion'
      when 'love'
        assign message = 'this is a love potion'
      else
        assign message = 'this is a potion'
    endcase

    echo message
  %}

  {% comment %} raw {% endcomment %}
  {% raw %}
    {{ 2 | plus: 2 }} equals 4.
    {% endraw %}

  {% comment %} break: 非循环中使用break，控制不输出哪一部分内容 {% endcomment %}
  {% assign max_num = 4 %}
  {% if 3 > max_num %}
    {% break %}
  {% endif %}
  <div>rest content</div>

  {% comment %} content_for {% endcomment %}
  {% comment %} {% content_for 'rich_text', block: block %} {% endcomment %}
  {% render 'header-search', input_id: 'My-Id' %}

  {% capture test %}
    定义文本变量
  {% endcapture %}

  {{ test }}

  {% assign title = 'Hello World' %}
  {% assign up_title = title | upcase %}
  {% assign down_title = title | downcase %}
  {% assign show_up_title = true %}
  {% capture title %}
    {% if show_up_title %}
      Upcase title: {{ up_title }}
    {% else %}
      Downcase title: {{ down_title }}
    {% endif %}
  {% endcapture %}

  {{ title }}

  {% assign num = 5 %}
  {% decrement num %}
  {% decrement num %}

  {% assign mix_num_list = '1,,3,test,false' | split: ',' %}

  {{ mix_num_list }}

  {% assign concat_list = list01 | reject: 'title', 'header' %}

  {% assign str = 'hello' %}
  {% assign str_len = str | size %}
  {{ str_len }}
  {{ str.size }}

  {% assign sort_list = list | sort: 'title' %}

  {% assign num_sum = '1, 3, 5, 7' | split: ', ' | sum %}
  {{ num_sum }}

  {{ cart | item_count_for_variant: 8366945402927 }}

  {% assign link_tags = 'extra-potent, fresh, healing, ingredients' | split: ', ' %}
  {{ link_tags }}

  {% for tag in link_tags %}
    {{ tag | highlight_active_tag | link_to_tag: tag }}
  {% endfor %}
</div>

<script>
  document.getElementById('contact-form-debug').addEventListener('submit', function (e) {
    // 阻止表单实际提交，仅用于调试
    e.preventDefault();

    const formData = new FormData(this);
    const data = {};

    // 将 FormData 转换为普通对象
    formData.forEach(function (value, key) {
      // 处理同名多值字段（如 checkbox group）
      if (data[key]) {
        if (!Array.isArray(data[key])) {
          data[key] = [data[key]];
        }
        data[key].push(value);
      } else {
        data[key] = value;
      }
    });

    console.log('📋 联系表单提交内容:', data);
    console.table(data);

    // ⚠️ 调试完成后，删除 e.preventDefault() 或取消下面注释以恢复正常提交
    // this.submit();
  });
</script>

{% schema %}
{
  "name": "Practice Component",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "practice_component",
      "label": "Practice Component",
      "default": "Practice Component"
    },
    {
      "type": "number",
      "id": "max_number",
      "label": "Max Number",
      "default": 5
    },
    {
      "type": "number",
      "id": "limit_number",
      "label": "limit_number",
      "default": 3
    },
    {
      "type": "text",
      "id": "test_text",
      "label": "test text",
      "default": "test text"
    }
  ],
  "presets": [
    {
      "name": "practice-component"
    }
  ]
}
{% endschema %}
