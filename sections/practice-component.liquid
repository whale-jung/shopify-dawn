<div>
  {{ section.settings.practice_component }}

  {% form 'contact', class: 'contact-form', id: 'contact-form-debug' %}
    {% if form.posted_successfully? %}
      <p class="note">消息已发送</p>
    {% endif %}

    {% if form.errors %}
      {{ form.errors | default_errors }}
    {% endif %}

    <label for="ContactFormName">姓名</label>
    <input
      type="text"
      id="ContactFormName"
      name="contact[name]"
      value="{% if form.name %}{{ form.name }}{% elsif customer %}{{ customer.name }}{% endif %}"
    >

    <label for="ContactFormEmail">邮箱</label>
    <input type="email" id="ContactFormEmail" name="contact[email]" required>

    <label for="ContactFormMessage">留言</label>
    <textarea id="ContactFormMessage" name="contact[body]" rows="5"></textarea>

    <!-- 自定义字段示例 -->
    <label for="ContactFormOrder">订单号（选填）</label>
    <input type="text" id="ContactFormOrder" name="contact[order_number]">

    <button type="submit">ENTER</button>
  {% endform %}

  {% for i in (1..5) %}
    {% if i == 4 %}
      {% break %}
    {% else %}
      <div>
        {{ i }}
      </div>
    {% endif %}
  {% endfor %}
</div>

<script>
  document.getElementById('contact-form-debug').addEventListener('submit', function (e) {
    // 阻止表单实际提交，仅用于调试
    e.preventDefault();

    const formData = new FormData(this);
    const data = {};

    // 将 FormData 转换为普通对象
    formData.forEach(function (value, key) {
      // 处理同名多值字段（如 checkbox group）
      if (data[key]) {
        if (!Array.isArray(data[key])) {
          data[key] = [data[key]];
        }
        data[key].push(value);
      } else {
        data[key] = value;
      }
    });

    console.log('📋 联系表单提交内容:', data);
    console.table(data);

    // ⚠️ 调试完成后，删除 e.preventDefault() 或取消下面注释以恢复正常提交
    // this.submit();
  });
</script>

{% schema %}
{
  "name": "Practice Component",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "practice_component",
      "label": "Practice Component",
      "default": "Practice Component"
    }
  ],
  "presets": [
    {
      "name": "practice-component"
    }
  ]
}
{% endschema %}
